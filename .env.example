# Copy to .env.local (dev) — never commit the filled-in file.

# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets — NEVER prefix with NEXT_PUBLIC_, never expose to client bundles ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used only by scripts/convert-artworks.mjs (one-off ingestion script, run locally/manually)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
